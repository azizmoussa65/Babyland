{
  "appId": "tn.ecole.babyland",
  "appName": "Baby Land",
  "webDir": "www",
  "android": {
    "backgroundColor": "#0d3b5e",
    "allowMixedContent": true,
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#fff7e8",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0d3b5e",
      "overlaysWebView": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
